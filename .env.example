# ANTHROPIC_API_KEY: powers the AI order-analysis and predictive-procurement endpoints
# (src/server/apiApp.ts). Optional — both endpoints fall back to an algorithmic report
# if unset. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""

# Supabase (the only persistent data store — see CLAUDE.md).
# SUPABASE_SERVICE_ROLE_KEY has full admin access — server-side only, never expose to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram bot token (@BotFather). Used to verify Telegram initData (Owner login,
# src/lib/telegramAuth.ts) and to send push notifications (src/lib/telegramNotify.ts).
TELEGRAM_BOT_TOKEN=""

# Owner's numeric Telegram user id — the only account recognized as the "owner" role.
# Get it by having that account message the bot once, then reading it via getUpdates.
OWNER_TELEGRAM_ID=""

# Comma-separated numeric Telegram ids of production managers to also notify on new
# registration requests, in addition to the Owner. Optional, can be left empty.
ADMIN_NOTIFY_TELEGRAM_IDS=""
# Shared secret Vercel Cron sends back as a Bearer token when it fires the deadline reminder
# (see vercel.json). Without it that route refuses to run, and nobody is reminded.
CRON_SECRET=""

# Shared secret Telegram echoes back on every webhook call (registered once via setWebhook —
# see POST /api/telegram/webhook). Without it, the phone-verification step in registration
# never receives the contact the user shared.
TELEGRAM_WEBHOOK_SECRET=""
